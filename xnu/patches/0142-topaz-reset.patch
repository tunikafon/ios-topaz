diff --git a/iokit/Kernel/arm/SweetReset.cpp b/iokit/Kernel/arm/SweetReset.cpp
new file mode 100644
index 0000000..ddf0cea
--- /dev/null
+++ b/iokit/Kernel/arm/SweetReset.cpp
@@ -0,0 +1,99 @@
+/*
+ * topaz: a reset path for hands-off debugging.
+ *
+ * Boot-arg sweet_reset=N: N seconds after the framebuffer starts, the phone
+ * resets the way the shim does it: IMEM restart_reason (0x0c12565c) is set to
+ * 0x77665500 (RESTART_BOOTLOADER, the value the ABL turns into fastboot), then
+ * PSCI SYSTEM_RESET over SMC. The prober's table says PSCI 1.1 answers on this
+ * TZ (SYSTEM_RESET works; SYSTEM_SUSPEND/SYSTEM_RESET2 do not), and the shim
+ * has been resetting the phone with exactly this pair since the first boot.
+ *
+ * sweet_reset_reason=<hex>  use another restart reason (e.g. 0x77665501).
+ * sweet_reset_pshold=1      also drop PS_HOLD (0x0440b000 = 0) if PSCI returns.
+ *
+ * Why: a GPU bring-up step can wedge the bus, and the console log only shows
+ * the last screenful. With this the test image always comes back to fastboot
+ * on its own; the PC then pulls the full log from the userdata ring through
+ * OrangeFox -- no buttons.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define IMEM_PA        0x0c125000ull
+#define IMEM_SIZE      0x1000ull
+#define IMEM_REASON    0x65c                   /* restart_reason@65c */
+#define RESTART_BOOTLOADER 0x77665500u
+#define PSCI_SYSTEM_RESET  0x84000009ull
+#define PSHOLD_PA      0x0440b000ull
+
+static uint32_t sweet_reset_secs;
+static uint32_t sweet_reset_reason = RESTART_BOOTLOADER;
+static uint32_t sweet_reset_pshold;
+
+static uint64_t
+sweet_smc(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn, x1 __asm__("x1") = 0, x2 __asm__("x2") = 0;
+
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2)
+	    :
+	    : "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+	    "x16", "x17", "memory");
+	return x0;
+}
+
+static void
+sweet_reset_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	volatile uint32_t *imem;
+
+	IOSleep(sweet_reset_secs * 1000);
+	IOLog("SWEET RESET: %u s are up, restart_reason %#x then PSCI SYSTEM_RESET\n", sweet_reset_secs,
+	    sweet_reset_reason);
+	imem = (volatile uint32_t *)ml_io_map(IMEM_PA, IMEM_SIZE);
+	if (imem != NULL) {
+		imem[IMEM_REASON / 4] = sweet_reset_reason;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		IOLog("SWEET RESET: IMEM[%#x] = %#x, SMC ...\n", IMEM_REASON, imem[IMEM_REASON / 4]);
+	} else {
+		IOLog("SWEET RESET: IMEM mapping failed\n");
+	}
+	sweet_smc(PSCI_SYSTEM_RESET);
+	IOLog("SWEET RESET: PSCI SYSTEM_RESET returned\n");
+	if (sweet_reset_pshold) {
+		volatile uint32_t *pshold = (volatile uint32_t *)ml_io_map(PSHOLD_PA, 0x1000);
+
+		if (pshold != NULL) {
+			*pshold = 0;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+	}
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+extern "C" void
+sweet_reset_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sweet_reset", &sweet_reset_secs, sizeof(sweet_reset_secs)) ||
+	    sweet_reset_secs == 0) {
+		return;
+	}
+	PE_parse_boot_argn("sweet_reset_reason", &sweet_reset_reason, sizeof(sweet_reset_reason));
+	PE_parse_boot_argn("sweet_reset_pshold", &sweet_reset_pshold, sizeof(sweet_reset_pshold));
+	if (kernel_thread_start(sweet_reset_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#else
+extern "C" void sweet_reset_init(void) {}
+#endif
