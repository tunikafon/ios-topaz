+static uint64_t gk_ib_va;
+static uint32_t *gk_ib;
+static bool g_reserved;
+
+/* Everything a warm restart needs, while pool writes are still safe: the
+ * page tables with the kernel buffers already mapped, the SQE bytes and the
+ * step-6 IB. After the CP has run, a CPU write into the pool stalls the bus
+ * (the adreno=6 hang), so none of this may happen after that. */
+static bool
+hw_reserve(void)
+{
+	uint32_t sqe_size = 0;
+	uint8_t *fw;
+
+	if (g_reserved) {
+		return true;
+	}
+	g_l1 = table_alloc(&g_l1_pa);
+	if (g_l1 == NULL) {
+		LOG("  reserve: no pool page for the L1 table");
+		return false;
+	}
+	if (!kbuf(0x8000, &gk_sqe_va, (void **)&gk_sqe) ||
+	    !kbuf(RB_BYTES, &gk_ring_va, (void **)&gk_ring) ||
+	    !kbuf(VA_BYTES, &gk_fence_va, (void **)&gk_fence) ||
+	    !kbuf(VA_BYTES, &gk_test_va, (void **)&gk_test) ||
+	    !kbuf(VA_BYTES, &gk_ib_va, (void **)&gk_ib)) {
+		LOG("  reserve: no room for the kept-on buffers");
+		return false;
+	}
+	fw = (uint8_t *)fw_get(fw_names[2], &sqe_size);
+	if (fw == NULL || sqe_size <= 4 || sqe_size > 0x8000) {
+		LOG("  reserve: no SQE firmware (%s, %u bytes)", fw_names[2], sqe_size);
+		if (fw != NULL) {
+			IOFree(fw, sqe_size);
+		}
+		return false;
+	}
+	memcpy(gk_sqe, fw + 4, sqe_size - 4);       /* the SQE without its first dword */
+	IOFree(fw, sqe_size);
+
+	/* the step-6 IB: a write of 0xC0FFEE01 into the test page */
+	gk_ib[0] = pkt7(CP_MEM_WRITE, 3);
+	gk_ib[1] = (uint32_t)gk_test_va;
+	gk_ib[2] = (uint32_t)(gk_test_va >> 32);
+	gk_ib[3] = 0xc0ffee01;
+	mb();
+	g_reserved = true;
+	LOG("reserve: L1 %#llx, ring %#llx, sqe %#llx, fence %#llx, test %#llx, ib %#llx", g_l1_pa, gk_ring_va,
+	    gk_sqe_va, gk_fence_va, gk_test_va, gk_ib_va);
+	return true;
+}
