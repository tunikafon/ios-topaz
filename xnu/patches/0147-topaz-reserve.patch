 		/* warm: the core is powered and the CP runs on identity addresses
 		 * (steps 4-5, or a service restart). Collapsing a RUNNING core
 		 * strands NOC transactions -- a CPU write into the pool then
-		 * stalls forever (that was the adreno=6 hang). Stop the CP and
-		 * keep the power; the zap shader stays authenticated. */
+		 * stalls forever (that was the adreno=6 hang), and so does any
+		 * pool write after the CP stops. From here to the restart:
+		 * registers only; everything else is reserved. */
 		step = 4;
