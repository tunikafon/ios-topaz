+/* ---------------------------------------------------------------- step 6: everything together */
+
+static bool
+step_vaspace(void)
+{
+	uint64_t ib_va = 0;
+	uint32_t *ib_cpu = NULL;
+	uint32_t fence, i;
+
+	announce("stage-1 tables, the CP on GPU addresses, one IB and a fence");
+	if (!hw_start()) {
+		return false;
+	}
+	if (!kbuf(0x100, &ib_va, (void **)&ib_cpu)) {
+		LOG("  pool: no room for the IB");
+		return false;
+	}
+	ib_cpu[0] = pkt7(CP_MEM_WRITE, 3);
+	ib_cpu[1] = (uint32_t)gk_test_va;
+	ib_cpu[2] = (uint32_t)(gk_test_va >> 32);
+	ib_cpu[3] = 0xc0ffee01;
+	redwood_gpu_to_memory(ib_cpu, 16);
+
+	const uint32_t ib_words = 4;
+
+	fence = redwood_gpu_submit(&ib_va, &ib_words, 1);
+	if (fence == 0) {
+		LOG("  submit failed");
+		return false;
+	}
+	for (i = 0; i < 5000; i++) {
+		if (redwood_gpu_done(fence)) {
+			break;
+		}
+		delay_for_interval(1000, NSEC_PER_USEC);
+	}
+	if (!redwood_gpu_done(fence)) {
+		redwood_gpu_report("the fence did not rise");
+		return false;
+	}
+	LOG("  fence %u up after %u ms, test buffer %08x %s", fence, i, gk_test[0],
+	    gk_test[0] == 0xc0ffee01 ? "= the IB ran on GPU addresses" : "(wrong value)");
+	return gk_test[0] == 0xc0ffee01;
+}
